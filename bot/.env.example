# Path to the panel config.toml (bot reads bot_token and admin_ids from it)
# If set, BOT_TOKEN and ADMIN_IDS below are optional (panel config takes priority if env is unset)
PANEL_CONFIG_PATH=/etc/telemt-panel/config.toml

# Telegram bot token (overrides panel config)
# BOT_TOKEN=123456789:AABBCCDDEEFFaabbccddeeff-1234567890

# Comma-separated admin Telegram User IDs (overrides panel config)
# ADMIN_IDS=123456789,987654321

# Telemt API URL (overrides panel config telemt.url)
# API_URL=http://localhost:9091/v1

# Telemt API auth header value (overrides panel config telemt.auth_header)
# TELEMT_AUTH_HEADER=your-secret

# MTProxy settings
PROXY_DOMAIN=your.proxy.domain
PROXY_PORT=4448
# PROXY_TLS_DOMAIN=your.proxy.domain  # defaults to PROXY_DOMAIN
