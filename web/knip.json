{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.tsx",
    "src/routes/**/*.{ts,tsx}",
    "src/**/*.test.{ts,tsx}",
    "scripts/*.{ts,mjs}",
    "e2e/**/*.ts",
    "vite.config.ts",
    "playwright.config.ts",
    "openapi-ts.config.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/*.{ts,mjs}", "e2e/**/*.ts", "*.ts"],
  "ignore": ["src/lib/api/generated/**", "src/routeTree.gen.ts"],
  "ignoreExportsUsedInFile": { "interface": true, "type": true },
  "ignoreDependencies": ["world-atlas"],
  "ignoreUnresolved": ["virtual:locale-urls"]
}
